// Windows resources: app icon + version info.
// GLFW (used by raylib) loads the icon named GLFW_ICON for the window and
// taskbar; Explorer shows the same icon for Valtrainer.exe.
#include <winver.h>

GLFW_ICON ICON "valtrainer.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2, 0, 1, 0
PRODUCTVERSION 2, 0, 1, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Valtrainer - aim trainer for Valorant players"
            VALUE "FileVersion", "2.0.1"
            VALUE "InternalName", "Valtrainer"
            VALUE "OriginalFilename", "Valtrainer.exe"
            VALUE "ProductName", "Valtrainer"
            VALUE "ProductVersion", "2.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
